# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only: NEVER expose to the browser or commit real values
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Provider mode: mock | sandbox | live
KYC_PROVIDER=mock
OPEN_BANKING_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Provider credentials (sandbox/live only)
KYC_API_KEY=
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com

# Admin notification emails (optional). The webhook refuses every call until WEBHOOK_SECRET is set.
# Use a long random value (16+ characters) and send it from Supabase as "Authorization: Bearer <secret>".
WEBHOOK_SECRET=
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
NOTIFY_FROM_EMAIL=Kasi Kapital <onboarding@resend.dev>

# Demo only: lets supporters verify themselves with one click. NEVER set to true in production.
ALLOW_DEMO_KYC=false
