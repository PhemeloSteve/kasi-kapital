{
  "name": "kasi-kapital",
  "version": "0.1.0",
  "private": true,
  "description": "Community funding platform for South African small businesses",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "audit": "npm audit --audit-level=high",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.json",
    "db:push": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --linked > src/infrastructure/supabase/database.types.ts",
    "e2e": "bash e2e/run-local.sh",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.63.0",
    "next": "^16.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
